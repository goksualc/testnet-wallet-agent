{
  "name": "testnet-wallet-agent",
  "version": "0.2.0",
  "description": "Global CLI and MCP server for EVM testnet wallet tools (Sepolia, Base Sepolia, Arbitrum Sepolia).",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "testnet-wallet-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "claude_desktop_config.example.json"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js dist/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/cli.ts",
    "dev:mcp": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector testnet-wallet-agent mcp",
    "pack:check": "npm pack --dry-run",
    "publish:public": "npm publish --access public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goksualc/testnet-wallet-agent.git"
  },
  "bugs": {
    "url": "https://github.com/goksualc/testnet-wallet-agent/issues"
  },
  "homepage": "https://github.com/goksualc/testnet-wallet-agent#readme",
  "keywords": [
    "cli",
    "mcp",
    "model-context-protocol",
    "viem",
    "ethereum",
    "sepolia",
    "testnet",
    "claude",
    "wallet"
  ],
  "author": "goksualc",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "viem": "^2.31.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
