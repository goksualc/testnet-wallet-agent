{
  "name": "testnet-wallet-agent",
  "version": "0.1.0",
  "description": "Local MCP server: testnet wallet tools for Claude via Viem (EVM testnets only).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "testnet-wallet-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
