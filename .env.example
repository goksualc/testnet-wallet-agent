# =============================================================================
# Testnet Wallet Agent — environment template
# Copy to .env:  cp .env.example .env
# Never commit .env (it contains your private key).
# =============================================================================

# REQUIRED: Private key for the agent wallet (32 bytes, 0x + 64 hex chars).
# Create a NEW key only for testnets — never reuse a mainnet key.
# Example generators: cast wallet new, MetaMask account export (test only)
PRIVATE_KEY=2048ddbd34e5855e6db373d2c5933266d3d5dc20398f42523fa408b7e412ae0dX

# REQUIRED: Active EVM testnet (mainnet is blocked in code).
#   sepolia          — Ethereum Sepolia (default MVP)
#   base-sepolia     — Base L2 testnet
#   arbitrum-sepolia — Arbitrum L2 testnet
CHAIN=sepolia

# OPTIONAL: Custom JSON-RPC URL (faster/more reliable than public defaults).
# Use Alchemy/Infura/QuickNode Sepolia endpoints if you have an API key.
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# OPTIONAL: Maximum ETH allowed per send_testnet_eth tool call (safety rail).
MAX_SEND_ETH=0.1
